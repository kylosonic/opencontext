# Use with docker/worker-hosted.Dockerfile on a container host.
# Do not commit a copy containing real secrets.
OPENCONTEXT_SKIP_DOTENV=1
WORKER_API_URL=https://your-opencontext-web.example
WORKER_API_TOKEN=
WORKER_ID=hosted-worker
WORKER_CONCURRENCY=1
WORKER_SHUTDOWN_GRACE_SECONDS=120
WORKER_JOB_TIMEOUT_SECONDS=900
HF_HOME=/models

TRANSCRIPTION_PROVIDER=faster_whisper
TRANSCRIPTION_MODEL=base
VISION_PROVIDER=openai_compatible
VISION_MODEL=glm-5.3-flash
VISION_CONCURRENCY=1
OCR_PROVIDER=vision
OCR_LANGUAGE=eng
TEXT_PROVIDER=template
OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENAI_API_KEY=
