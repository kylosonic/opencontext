{
  "name": "opencontext",
  "version": "0.1.3",
  "private": true,
  "description": "Turn video and images into context for text-only AI",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build --workspace @kylosonic/opencontext-schemas && npm run dev --workspace web",
    "compose:demo": "node scripts/real-vision-demo.mjs",
    "fixture": "node scripts/generate-fixture.mjs",
    "media:corpus": "node scripts/download-media-corpus.mjs",
    "media:verify": "node scripts/verify-media-corpus.mjs",
    "evaluation:heldout:download": "node scripts/download-heldout-evaluation-corpus.mjs",
    "evaluation:heldout:run": "node scripts/run-heldout-evaluation.mjs",
    "security:waf:plan": "node scripts/configure-vercel-waf.mjs",
    "security:waf:apply": "node scripts/configure-vercel-waf.mjs --apply",
    "smoke:deploy": "node scripts/post-deploy-smoke.mjs",
    "rollback:dry-run": "node scripts/vercel-rollback.mjs --dry-run",
    "evaluation:video": "node scripts/generate-measured-evaluation-video.mjs",
    "evaluation:hearing-video": "node scripts/generate-hearing-evaluation-video.mjs",
    "vision:fixture": "node scripts/generate-vision-reference.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:contracts && npm run test --workspaces --if-present",
    "test:rate-limit-load": "node scripts/rate-limit-load-test.mjs",
    "test:contracts": "node --test scripts/*.test.mjs",
    "build": "npm run build --workspace @kylosonic/opencontext-schemas && npm run build --workspace web"
  },
  "devDependencies": {
    "js-yaml": "^4.3.2"
  }
}
