{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "prisma:generate:postgres": "node ../../scripts/prisma-schema.mjs postgresql && prisma generate --schema prisma/.generated/schema.prisma",
    "prisma:push:postgres": "node ../../scripts/prisma-schema.mjs postgresql && prisma db push --schema prisma/.generated/schema.prisma --skip-generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.862.0",
    "@aws-sdk/s3-request-presigner": "^3.862.0",
    "@opencontext/config": "*",
    "@opencontext/schemas": "*",
    "@prisma/client": "^6.19.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
