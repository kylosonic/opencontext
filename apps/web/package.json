{
  "name": "web",
  "version": "0.1.3",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node ../../scripts/prisma-generate.mjs && npm --prefix ../../packages/schemas run build",
    "build": "next build --webpack",
    "postbuild": "node ../../scripts/prisma-migrate-build.mjs",
    "start": "next start",
    "postinstall": "node ../../scripts/prisma-generate.mjs",
    "prisma:generate": "prisma generate",
    "pretypecheck": "npm --prefix ../../packages/schemas run build",
    "prisma:generate:postgres": "node ../../scripts/prisma-schema.mjs postgresql && prisma generate --config prisma.postgres.config.ts",
    "prisma:migrate:deploy:postgres": "node ../../scripts/prisma-schema.mjs postgresql && prisma migrate deploy --config prisma.postgres.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@kylosonic/opencontext-schemas": "*",
    "@opencontext/config": "*",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/oidc-aws-credentials-provider": "^3.3.19",
    "dotenv": "^17.2.3",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^7.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "stripe": "23.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
