{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm --prefix ../../packages/schemas run build",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "pretypecheck": "npm --prefix ../../packages/schemas run build",
    "prisma:generate:postgres": "node ../../scripts/prisma-schema.mjs postgresql && prisma generate --config prisma.postgres.config.ts",
    "prisma:migrate:deploy:postgres": "node ../../scripts/prisma-schema.mjs postgresql && prisma migrate deploy --config prisma.postgres.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.862.0",
    "@aws-sdk/s3-request-presigner": "^3.862.0",
    "@opencontext/config": "*",
    "@opencontext/schemas": "*",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
