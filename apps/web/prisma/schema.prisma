// OpenContext data model — technical-blueprint.md §1 + Auth.js adapter models.
// Portable per ADR-0003: cuid() ids, Json for arrays, no SKIP LOCKED.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum JobStatus {
  QUEUED
  DOWNLOADING
  EXTRACTING
  TRANSCRIBING
  ANALYZING
  AGGREGATING
  GENERATING_CONTEXT
  COMPLETED
  PARTIAL
  FAILED
}

enum DetailLevel {
  LOW
  MEDIUM
  HIGH
}

enum FailureKind {
  NONE
  TRANSIENT
  PERMANENT
}

enum StageName {
  EXTRACTING
  TRANSCRIBING
  ANALYZING
  AGGREGATING
  GENERATING_CONTEXT
}

enum StageStatus {
  NOT_STARTED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum MediaKind {
  SOURCE
  AUDIO
  FRAME
}

enum Certainty {
  OBSERVED
  INFERRED
  UNCERTAIN
}

// ─── Auth.js adapter models (GitHub OAuth via @auth/prisma-adapter) ──────────

model User {
  id            String    @id @default(cuid())
  // Blueprint §1 identity fields. Nullable because @auth/prisma-adapter
  // creates the row from name/email/image before the signIn event can
  // backfill the GitHub identity (see src/auth.ts `events.signIn`).
  githubId      String?   @unique
  githubLogin   String?
  name          String?
  avatarUrl     String?
  // Adapter-standard fields (avatarUrl is mirrored into `image`).
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  jobs     Job[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ─── Pipeline ────────────────────────────────────────────────────────────────

model Job {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  status      JobStatus    @default(QUEUED)
  detailLevel DetailLevel  @default(MEDIUM)
  progress    Int          @default(0)
  error       String?
  errorStage  StageName?
  failureKind FailureKind  @default(NONE)
  retryCount  Int          @default(0)

  // Single authority for stage completion (blueprint §1; powers B4/B5 resume).
  // Required (no DB default) — the jobs layer always writes the 5-stage array.
  stageStates Json

  // Queue fields (ADR-0001): claimedBy is the worker id; leaseUntil is the
  // visibility timeout; availableAt delays re-claim for auto-retry backoff.
  claimedBy  String?
  leaseUntil DateTime?
  availableAt DateTime?
  attempts   Int       @default(0)

  // Source probe metadata (set by EXTRACTING stage-result).
  sourceKey    String?
  sourceSize   Int?
  sourceExt    String?
  durationSec  Float?
  width        Int?
  height       Int?
  audioPresent Boolean?
  frameCount   Int?

  // AGGREGATING output (timeline payload) — persisted here so PARTIAL jobs
  // keep their timeline viewable even when GENERATING_CONTEXT never ran.
  timeline Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  media        Media[]
  segments     TranscriptSegment[]
  observations VisualObservation[]
  ocr          OcrObservation[]
  result       ProcessingResult?

  @@index([userId, createdAt])
  @@index([status, availableAt])
}

model Media {
  id           String    @id @default(cuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind         MediaKind
  key          String
  mime         String?
  sizeBytes    Int
  timestampSec Float?
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())

  @@index([jobId, kind])
}

model TranscriptSegment {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  start     Float
  end       Float
  text      String
  provider  String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

model VisualObservation {
  id                String    @id @default(cuid())
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  frameId           String?
  timestampSec      Float
  certainty         Certainty @default(OBSERVED)
  sceneTitle        String?
  visualDescription String?
  uiElements        Json
  visibleText       Json
  interactions      Json
  layoutDescription String?
  designObservations Json
  importantChanges  Json
  provider          String?
  createdAt         DateTime  @default(now())

  @@index([jobId, timestampSec])
}

model OcrObservation {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  frameId      String?
  timestampSec Float
  text         String
  confidence   Float?
  provider     String?
  createdAt    DateTime @default(now())

  @@index([jobId, timestampSec])
  @@map("OCRObservation")
}

model ProcessingResult {
  id            String   @id @default(cuid())
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  markdown      String
  json          Json
  formatVersion Int      @default(1)
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
