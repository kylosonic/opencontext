{
  "name": "@opencontext/schemas",
  "version": "0.1.0",
  "description": "Shared TypeScript and Zod contracts for OpenContext jobs, media, evidence, and worker payloads",
  "license": "MIT",
  "author": "OpenContext contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylosonic/opencontext.git",
    "directory": "packages/schemas"
  },
  "keywords": ["opencontext", "zod", "schemas", "video", "evidence"],
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
