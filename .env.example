# OpenContext environment configuration
# Copy to .env (and .env.local for Next.js) and fill in values as needed.
# All values shown are examples/dev defaults — never real credentials.

# --- Core ---
# Database connection string. Dev default is a local SQLite file.
DATABASE_URL=file:./dev.db

# Storage backend: "local" (filesystem, default) or "s3" (S3-compatible object storage).
STORAGE_PROVIDER=local

# Local storage root when STORAGE_PROVIDER=local.
STORAGE_PATH=storage

# S3-compatible object storage (only used when STORAGE_PROVIDER=s3)
STORAGE_S3_ENDPOINT=https://s3.example.com
STORAGE_S3_BUCKET=opencontext-media
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=change-me
STORAGE_S3_SECRET_ACCESS_KEY=change-me
# Optional public base URL for serving objects (not required by the app).
# STORAGE_S3_PUBLIC_BASE_URL=https://media.example.com

# --- Queue ---
# Optional Redis URL for future queue backends. Dev uses a DB-backed queue; leave unset.
# REDIS_URL=redis://localhost:6379

# --- Auth ---
# Secret used to sign/encrypt sessions and tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# GitHub OAuth app credentials.
AUTH_GITHUB_ID=change-me
AUTH_GITHUB_SECRET=change-me
# Local-only passwordless sign-in. Keep false by default; docker compose sets
# it explicitly for local development. Never enable this on a public deployment.
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=local@opencontext.dev

# --- Worker ---
# Token the web app sends to the worker API for service-to-service authentication.
WORKER_API_TOKEN=change-me

# --- Transcription ---
# "faster_whisper" (local; install the worker's [local] extra),
# "fixture" (offline deterministic test output), or "openai_compatible".
TRANSCRIPTION_PROVIDER=faster_whisper
# Model name for the transcription provider (e.g. "base", "small" for faster-whisper).
TRANSCRIPTION_MODEL=base

# OpenAI-compatible API settings (used when TRANSCRIPTION_PROVIDER=openai_compatible
# or VISION_PROVIDER=openai_compatible).
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vision / OCR ---
# "fixture" (offline deterministic test output), "ollama" (local), or
# "openai_compatible".
VISION_PROVIDER=fixture
VISION_MODEL=gpt-4o-mini
# Ollama server URL (used when VISION_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# --- Text-only AI ---
# "template" is deterministic and needs no credentials.
TEXT_PROVIDER=template
TEXT_MODEL=gpt-4o-mini

# --- App ---
# Public URL of the web app, exposed to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side base URL used by background services.
APP_BASE_URL=http://localhost:3000
