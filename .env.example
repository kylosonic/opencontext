# OpenContext environment configuration
# Copy to .env (and .env.local for Next.js) and fill in values as needed.
# All values shown are examples/dev defaults — never real credentials.

# --- Core ---
# Database connection string. The web process resolves this path from apps/web.
DATABASE_URL=file:./prisma/dev.db
# PostgreSQL pool tuning. Vercel defaults to a small three-connection pool;
# persistent web containers default to ten. Use the database provider's pooled
# connection string in serverless environments.
# DB_POOL_MAX=3
# DB_POOL_IDLE_TIMEOUT_MS=10000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Optional direct (unpooled) PostgreSQL URL used by Prisma migrations when
# DATABASE_URL points to a connection pooler. Checked in order: DIRECT_URL,
# DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING, then DATABASE_URL (for Neon
# `-pooler` endpoints, the direct host is derived automatically when omitted).
# DIRECT_URL=postgresql://user:password@host:5432/opencontext
# Build-time PostgreSQL migration switch (`scripts/prisma-migrate-build.mjs`).
# Auto-runs on Vercel Production (`VERCEL=1`, `VERCEL_ENV=production`) when a
# PostgreSQL URL is set; skips Preview and local builds unless set to `true`.
# Set to `false` to opt out on Vercel Production builds.
# PRISMA_MIGRATE_ON_BUILD=false

# Storage backend: "local" (filesystem, default) or "s3" (S3-compatible object storage).
STORAGE_PROVIDER=local

# Local storage root when STORAGE_PROVIDER=local.
STORAGE_PATH=storage

# S3-compatible object storage (only used when STORAGE_PROVIDER=s3)
# Static credentials work with any S3-compatible endpoint (R2, MinIO, S3Mock).
STORAGE_S3_ENDPOINT=https://s3.example.com
STORAGE_S3_BUCKET=opencontext-media
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=change-me
STORAGE_S3_SECRET_ACCESS_KEY=change-me
# Optional public base URL for serving objects (not required by the app).
# STORAGE_S3_PUBLIC_BASE_URL=https://media.example.com
# AWS-only alternative: Vercel OIDC role assumption from a Vercel Marketplace AWS
# integration. Set these instead of the five STORAGE_S3_* values above.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/vercel-oidc-role
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=opencontext-media

# --- Queue ---
# Optional Redis URL for future queue backends. Dev uses a DB-backed queue; leave unset.
# REDIS_URL=redis://localhost:6379

# Optional immediate wake-up for the GitHub Actions worker relay. Dispatch is
# off unless both values are set. Use a fine-grained token limited to one
# repository with Contents: Read and write; do not reuse an OAuth or worker
# token. The workflow's serialized concurrency group coalesces burst events.
# GITHUB_WORKER_DISPATCH_TOKEN=github_pat_change-me
# GITHUB_WORKER_DISPATCH_REPOSITORY=kylosonic/opencontext
# Optional bounded request timeout (250-10000 ms). Defaults to 3000 ms.
# GITHUB_WORKER_DISPATCH_TIMEOUT_MS=3000

# --- Rate limiting ---
# "memory" is the credential-free single-instance default. Use "database" for
# multi-instance deployments backed by the shared Postgres database.
RATE_LIMIT_BACKEND=memory
# If the selected backend fails, "open" preserves availability and "closed"
# rejects requests. Choose explicitly for your production risk model.
RATE_LIMIT_FAILURE_MODE=open
# Rate-limit request keys are derived from an address only when the deployment
# tells the app which proxy headers are trustworthy. Vercel headers are handled
# automatically. On another reverse-proxy deployment, enable this and count the
# proxies in front of the app (one Nginx/ALB hop is the default below).
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1

# --- Auth ---
# Secret used to sign/encrypt sessions and tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# Trust the request Host header when this process is the intended public edge
# (for example, the Compose stack or a directly exposed container). Leave unset
# to preserve Auth.js's AUTH_URL/development fallback. Vercel is trusted
# automatically; use an explicit false only to opt out.
# AUTH_TRUST_HOST=true
# GitHub OAuth app credentials.
AUTH_GITHUB_ID=change-me
AUTH_GITHUB_SECRET=change-me
# Optional Google OAuth credentials.
# AUTH_GOOGLE_ID=change-me
# AUTH_GOOGLE_SECRET=change-me
# Optional generic Enterprise OIDC SSO credentials (Okta, Entra ID, Auth0, etc.).
# AUTH_OIDC_ID=change-me
# AUTH_OIDC_SECRET=change-me
# AUTH_OIDC_ISSUER=https://idp.example.com
# AUTH_OIDC_NAME=Enterprise SSO
# Local-only passwordless sign-in. Keep false by default; docker compose sets
# it explicitly for local development. Never enable this on a public deployment.
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=local@opencontext.dev

# --- Worker ---
# Token the web app sends to the worker API for service-to-service authentication.
WORKER_API_TOKEN=change-me
# Token for authenticated operations alerts and detailed readiness diagnostics.
# OPS_API_TOKEN=change-me

# --- Transcription ---
# "faster_whisper" (local; install the worker's [local] extra),
# "fixture" (offline deterministic test output), "openai_compatible" for an
# audio-transcriptions endpoint, or "openai_audio" for an audio-capable
# OpenAI-compatible chat model such as OpenCode Go's MiMo audio models.
TRANSCRIPTION_PROVIDER=faster_whisper
# Model name for the transcription provider (e.g. "base", "small" for faster-whisper).
TRANSCRIPTION_MODEL=base
# Hardware accelerator and compute type for local Faster Whisper ("auto", "cpu", "cuda").
# WORKER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=auto

# OpenAI-compatible API settings (used when TRANSCRIPTION_PROVIDER=openai_compatible
# or VISION_PROVIDER=openai_compatible).
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenCode Go alternative. OPENCODE_API_KEY is used when OPENAI_API_KEY is unset.
# OPENCODE_API_KEY=change-me
# OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_SESSION_ID=opencontext-local

# --- Vision / OCR ---
# "fixture" (offline deterministic test output), "ollama" (local), or
# "openai_compatible". docker-compose.yml uses "fixture" by default.
VISION_PROVIDER=fixture
VISION_MODEL=gpt-4o-mini
# OpenCode Go vision example:
# VISION_PROVIDER=openai_compatible
# VISION_MODEL=hy4-flash-free
# Comma-separated fallbacks are tried only when the primary model returns 429.
# VISION_FALLBACK_MODELS=glm-5.3-flash
# Minimum delay between provider requests from one worker process.
# VISION_REQUEST_INTERVAL_SECONDS=5
# Limit simultaneous provider calls when the upstream account is rate-limited.
# VISION_CONCURRENCY=1
# Maximum video/PDF frames analyzed per job, evenly sampled.
# VISION_MAX_FRAMES=60
# Frame extraction cadence: "fixed" (even interval) or "hybrid" (scene cuts + interval).
# FRAME_SAMPLING_MODE=fixed
# Scene change threshold in [0.05, 0.95] used when FRAME_SAMPLING_MODE=hybrid.
# SCENE_CHANGE_THRESHOLD=0.25
# Conservative de-duplication after hybrid sampling, for videos only. A frame
# is removed only when both checks match; first/final frames and decode failures
# are always retained. Hash distance is bounded to [0,16].
# FRAME_DEDUP_HASH_DISTANCE=2
# Normalized RGB pixel RMS is bounded to [0,32].
# FRAME_DEDUP_PIXEL_RMS=1.25
# Native Gemini image analysis:
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-4-hydrogen
# GEMINI_API_KEY=use-a-local-secret
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VISION_TIMEOUT_SECONDS=120
# Ollama server URL (used when VISION_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# --- Local Compose real-vision demo ---
# Keep "fixture" for no external calls. Set "real" to use one image-capable
# model for vision and its OpenAI-compatible text stage; set the FULL model
# name (a current compatible model may differ from gpt-4o-mini). The image
# is sent to the configured provider and may incur charges. Use a synthetic,
# non-sensitive image. Docker Compose reads this optional file only when you
# pass --env-file .env.local; it is ignored by Git.
# OPENCONTEXT_DEMO_VISION=real
# OPENCONTEXT_DEMO_MODEL=image-capable-model
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=use-a-local-secret

# If you run `docker compose` directly instead of `npm run compose:demo`, use
# these prefixed values. They keep inherited host credentials out of a fixture
# worker that does not use them. Do not write the key into Git.
# OPENCONTEXT_DEMO_OPENAI_BASE_URL=https://your-provider.example/v1
# OPENCONTEXT_DEMO_OPENAI_API_KEY=use-a-local-secret

# --- OCR ---
# "vision" keeps the compatibility behavior of deriving OCR rows from the
# vision response. "tesseract" runs the local Tesseract binary independently,
# and "fixture" provides deterministic test output.
OCR_PROVIDER=vision
OCR_LANGUAGE=eng
TESSERACT_PATH=tesseract

# --- Text-only AI ---
# "template" is deterministic and needs no credentials.
TEXT_PROVIDER=template
TEXT_MODEL=gpt-4o-mini

# --- Context compression & plugins (optional worker tuning) ---
# CONTEXT_COMPRESSION_MODE: "none" (default), "compact", or "aggressive".
# CONTEXT_COMPRESSION_MODE=none
# Optional estimated token budget ceiling when compression is enabled (0 = unlimited).
# CONTEXT_MAX_TOKENS=0
# Comma-separated worker plugins (`module.path:attribute`) and entry-point discovery.
# OPENCONTEXT_PLUGINS=
# OPENCONTEXT_LOAD_ENTRYPOINT_PLUGINS=true

# --- App ---
# Public URL of the web app, exposed to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side base URL used by background services.
APP_BASE_URL=http://localhost:3000
# Workspace invitation link expiry in hours (1-720, defaults to 168 / 7 days).
# WORKSPACE_INVITE_TTL_HOURS=168
# Optional HMAC-SHA256 secret used by scripts/check-operations.mjs webhook alerts.
# ALERT_WEBHOOK_SECRET=replace-with-long-random-secret

# --- Retention ---
# Completed jobs and incomplete jobs can use independent retention windows.
# RETENTION_COMPLETED_DAYS=14
# RETENTION_INCOMPLETE_DAYS=7

# --- Usage / rebilling ledger ---
# Provider-neutral analysis prices, expressed in micro-units of currency.
# Zero keeps accounting enabled without charging. Configure reconciled prices
# before exporting usage to Stripe or an internal invoicing system.
# BILLING_ANALYSIS_MICROS_PER_SECOND=0
# BILLING_STILL_JOB_MICROS=0

# --- Stripe subscription billing (optional, test mode by default) ---
# Billing stays disabled unless the server key, webhook secret, recurring price
# ID, and APP_BASE_URL above are all present. Use test-mode keys while validating
# Checkout and Billing Portal. Live keys are rejected unless
# STRIPE_ALLOW_LIVE_MODE=true is set deliberately by the deployment owner.
# STRIPE_SECRET_KEY=sk_test_change-me
# STRIPE_WEBHOOK_SECRET=whsec_change-me
# STRIPE_PRICE_ID=price_change-me
# Submit positive analysis usage as Stripe invoice items on the next invoice.
# Keep false until the per-unit prices above and invoice/tax policy are approved.
# STRIPE_USAGE_BILLING_ENABLED=false
# STRIPE_ALLOW_LIVE_MODE=false

# --- Edge firewall planning ---
# Optional thresholds consumed by `node scripts/configure-vercel-waf.mjs`.
# Start in dry-run mode, inspect actual traffic, then apply deliberately.
# WAF_AUTH_LIMIT_PER_MINUTE=120
# WAF_URL_IMPORT_LIMIT_PER_HOUR=30
# WAF_WORKER_LIMIT_PER_MINUTE=1200
